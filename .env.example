# --- Database ---------------------------------------------------------------
# Local Postgres running in WSL2 (or via Docker). Adjust user/password/db.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_dev?schema=public"

# --- Auth.js (OPTIONAL) -----------------------------------------------------
# Only needed if you enable authentication (see README "Optional: Authentication").
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""

# Example: GitHub OAuth provider (create an app at github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
